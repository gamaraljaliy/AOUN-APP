SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Backend-only. Use a Supabase secret key for private review photo signing.
SUPABASE_REVIEW_PHOTO_SECRET_KEY=
# A server-only random secret of at least 32 bytes, shared by preparation and signing.
REVIEW_PHOTO_VALIDATION_KEY=
# Optional comma-separated trusted Expo Web origins.
REVIEW_PHOTO_WEB_ORIGINS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
